{
	"compilerOptions": {
		"target": "esnext",
		"lib": ["esnext"],
		"module": "esnext",
		"rootDir": "./src",
		"outDir": "./dist",
		"declaration": true,
		"emitDeclarationOnly": true,
		"noImplicitAny": true,
		"skipLibCheck": true,
		"types": ["google-apps-script"]
	},
	"include": ["src/**/*.ts"]
}
